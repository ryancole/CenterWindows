#include <windows.h>

// VERSION_MAJOR, VERSION_MINOR and VERSION_PATCH come from the AppVersion
// msbuild property (see CenterWindows.vcxproj), which the release workflow
// sets from the git tag
#define STRINGIFY2(x) #x
#define STRINGIFY(x) STRINGIFY2(x)
#define VERSION_STRING STRINGIFY(VERSION_MAJOR.VERSION_MINOR.VERSION_PATCH)

VS_VERSION_INFO VERSIONINFO
FILEVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
PRODUCTVERSION VERSION_MAJOR, VERSION_MINOR, VERSION_PATCH, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "Centers windows on their monitor"
			VALUE "FileVersion", VERSION_STRING
			VALUE "InternalName", "CenterWindows"
			VALUE "OriginalFilename", "CenterWindows.exe"
			VALUE "ProductName", "CenterWindows"
			VALUE "ProductVersion", VERSION_STRING
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
